# Anthropic API Key (for Claude 3.5 Sonnet / Claude 5.5 AI Analyst)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Credentials (Optional for demo/fallback mode; required for persistent cloud auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# News API Key (Optional; Google News RSS works without key)
NEWS_API_KEY=

# Allowed Origin for CORS (e.g., frontend URL)
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Server settings
PORT=8000
HOST=0.0.0.0

