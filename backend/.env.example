# Anthropic API Key (for Claude 3.5 Sonnet / Claude 5.5 AI Analyst)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Credentials (Optional for demo/fallback mode; required for persistent cloud auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# News API Key (Optional; Google News RSS works without key)
NEWS_API_KEY=

# Allowed Origin for CORS (e.g., frontend URL)
ALLOWED_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Server settings
PORT=8000
HOST=0.0.0.0

# Real Email OTP Delivery Options (Choose either Supabase Auth, SMTP, or Resend):
# 1. Gmail SMTP:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASSWORD=your_16_digit_gmail_app_password
# SMTP_FROM_EMAIL=your_email@gmail.com

# 2. Resend API (Free at resend.com):
# RESEND_API_KEY=re_your_resend_api_key


